# Rendered by deploy.sh on every deploy. Do not edit on the server; edit the template.
# Secrets (ANTHROPIC_API_KEY) live in __ROOT__/secrets.env, which deploy never touches.
MATE_PORT=4545
MATE_CORS_ORIGIN=https://__DOMAIN__
MATE_TICK_MS=5000
MATE_ABLETON=stub
# auto: uses Splice when SPLICE_MCP_TOKEN (secrets.env) or the OAuth file below exists, else fixtures.
MATE_SPLICE=auto
SPLICE_OAUTH_FILE=__ROOT__/data/splice-oauth.json
SPLICE_OAUTH_CALLBACK_PORT=4546
MATE_BRAIN=anthropic
MATE_TEMPLATES_DIR=__ROOT__/data/templates
MATE_BANDS_DIR=__ROOT__/data/bands
MATE_SONGS_DIR=__ROOT__/data/songs
MATE_RECIPES_DIR=__ROOT__/data/recipes
NEXT_PUBLIC_MATE_URL=https://__DOMAIN__/mate
NODE_ENV=production

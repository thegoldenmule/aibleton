[Unit]
Description=aibleton web app (next start)
After=network.target aibleton-mate.service

[Service]
User=__USER__
WorkingDirectory=__ROOT__/src/app
EnvironmentFile=__ROOT__/app.env
ExecStart=__NODE__ node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

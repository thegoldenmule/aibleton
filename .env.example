# mate
MATE_PORT=4545
MATE_CORS_ORIGIN=http://localhost:3000
MATE_TICK_MS=5000
# auto | mcp | stub
MATE_ABLETON=auto
MATE_SPLICE=auto
# auto | anthropic | scripted
MATE_BRAIN=auto
MATE_MODEL=claude-opus-5
# Where song templates are persisted (created on first write).
MATE_TEMPLATES_DIR=.mate/templates
# Where bands are persisted (created on first write).
MATE_BANDS_DIR=.mate/bands
# Where composed songs are persisted (created on first write).
MATE_SONGS_DIR=.mate/songs
# Where downloaded Splice files land (created on first download). Each download spends a Splice credit.
MATE_DOWNLOADS_DIR=.mate/downloads
# Where saved sessions are persisted: one directory per session, plus current.json.
MATE_SESSIONS_DIR=.mate/sessions
# Where the band and template logs live (bands.jsonl, templates.jsonl). These are the truth for
# those libraries; MATE_BANDS_DIR and MATE_TEMPLATES_DIR hold the rebuildable JSON projection.
MATE_LIBRARY_DIR=.mate/library
# Compact a session journal past this many bytes; 0 never compacts (compaction is not implemented yet).
MATE_JOURNAL_COMPACT_BYTES=0
# Where model-written band recipes are persisted (built-ins live in code).
MATE_RECIPES_DIR=.mate/recipes
# Optional; the SDK also resolves ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
# ANTHROPIC_API_KEY=
# Splice MCP OAuth: `bun run --cwd mate splice:login` opens the browser once and saves the client
# registration and tokens here (mode 0600, refreshed automatically). Without it, MATE_SPLICE=auto uses fixtures.
SPLICE_OAUTH_FILE=.mate/splice-oauth.json
# Localhost port the login command listens on for the OAuth redirect (http://localhost:<port>/callback).
SPLICE_OAUTH_CALLBACK_PORT=4546
# Optional plain bearer token for the Splice MCP server; overrides the OAuth login when set.
# SPLICE_MCP_TOKEN=
